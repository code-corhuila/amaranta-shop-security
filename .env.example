# Names and placeholders only. Copy to .env (git-ignored) and fill it in locally.
# The variables come from ADR-011 (identity design) and ADR-010 (engine per domain).

PORT=8080

# Connects as this domain's own user, never as the administrator (Annex J, J.4).
# Schema `security` in the single PostgreSQL instance of amaranta-shop-infra-postgres.
DATABASE_URL=postgres://security_app:<password>@postgres:5432/amaranta

# The private signing key exists ONLY in this service (ADR-009, ADR-011). Every other
# service verifies tokens with the public key and cannot mint one.
JWT_PRIVATE_KEY_FILE=/run/secrets/jwt-private.pem

# Access token: short-lived. Refresh token: opaque, stored hashed and rotated on every use.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
